void JumpStm::Munch(assem::InstrList &instr_list, std::string_view fs) {
  /* TODO: Put your lab5 code here */
  instr_list.Append(new assem::OperInstr(
    "jmp `j0",
    nullptr,
    nullptr,
    new assem::Targets(jumps_)
  ));
  /* End for lab5 code */
}

void CjumpStm::Munch(assem::InstrList &instr_list, std::string_view fs) {
  /* TODO: Put your lab5 code here */
  temp::Temp *left = left_->Munch(instr_list, fs);
  temp::Temp *right = right_->Munch(instr_list, fs);

  auto src = new temp::TempList();
  src->Append(left);
  src->Append(right);

  instr_list.Append(new assem::OperInstr(
    "cmpq `s1, `s0",
    nullptr,
    src,
    nullptr
  ));

  std::string jump_instr;
  switch (op_) {
    case EQ_OP: jump_instr = "je `j0"; break;
    case NE_OP: jump_instr = "jne `j0"; break;
    case LT_OP: jump_instr = "jl `j0"; break;
    case LE_OP: jump_instr = "jle `j0"; break;
    case GT_OP: jump_instr = "jg `j0"; break;
    case GE_OP: jump_instr = "jge `j0"; break;
    default: assert(false);
  }

  auto targets = new std::vector<temp::Label *>();
  targets->push_back(true_label_);
  targets->push_back(false_label_);

  instr_list.Append(new assem::OperInstr(
    jump_instr,
    nullptr,
    nullptr,
    new assem::Targets(targets)
  ));
  /* End for lab5 code */
}

void MoveStm::Munch(assem::InstrList &instr_list, std::string_view fs) {
  /* TODO: Put your lab5 code here */
  // MOVE(MEM(e1), e2)
  if (typeid(*dst_) == typeid(tree::MemExp)) {
    auto mem = static_cast<tree::MemExp *>(dst_);
    temp::Temp *src = src_->Munch(instr_list, fs);
    temp::Temp *addr = mem->exp_->Munch(instr_list, fs);

    auto src_list = new temp::TempList();
    src_list->Append(src);
    src_list->Append(addr);

    instr_list.Append(new assem::OperInstr(
      "movq `s0, (`s1)",
      nullptr,
      src_list,
      nullptr
    ));
  }
  // MOVE(TEMP(t), e)
  else if (typeid(*dst_) == typeid(tree::TempExp)) {
    auto temp_exp = static_cast<tree::TempExp *>(dst_);

    // MOVE(TEMP(t), MEM(e))
    if (typeid(*src_) == typeid(tree::MemExp)) {
      auto mem = static_cast<tree::MemExp *>(src_);
      temp::Temp *addr = mem->exp_->Munch(instr_list, fs);

      auto src_list = new temp::TempList();
      src_list->Append(addr);

      auto dst_list = new temp::TempList();
      dst_list->Append(temp_exp->temp_);

      instr_list.Append(new assem::OperInstr(
        "movq (`s0), `d0",
        dst_list,
        src_list,
        nullptr
      ));
    }
    // MOVE(TEMP(t), CONST(i))
    else if (typeid(*src_) == typeid(tree::ConstExp)) {
      auto const_exp = static_cast<tree::ConstExp *>(src_);

      auto dst_list = new temp::TempList();
      dst_list->Append(temp_exp->temp_);

      instr_list.Append(new assem::OperInstr(
        "movq $" + std::to_string(const_exp->consti_) + ", `d0",
        dst_list,
        nullptr,
        nullptr
      ));
    }
    // MOVE(TEMP(t), e)
    else {
      temp::Temp *src = src_->Munch(instr_list, fs);

      auto src_list = new temp::TempList();
      src_list->Append(src);

      auto dst_list = new temp::TempList();
      dst_list->Append(temp_exp->temp_);

      instr_list.Append(new assem::MoveInstr(
        "movq `s0, `d0",
        dst_list,
        src_list
      ));
    }
  }
  /* End for lab5 code */
}

void ExpStm::Munch(assem::InstrList &instr_list, std::string_view fs) {
  /* TODO: Put your lab5 code here */
  exp_->Munch(instr_list, fs);
