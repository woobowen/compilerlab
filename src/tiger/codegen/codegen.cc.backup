temp::Temp *BinopExp::Munch(assem::InstrList &instr_list, std::string_view fs) {
  /* TODO: Put your lab5 code here */
  temp::Temp *left = left_->Munch(instr_list, fs);
  temp::Temp *right = right_->Munch(instr_list, fs);
  temp::Temp *r = temp::TempFactory::NewTemp();

  auto src = new temp::TempList();
  src->Append(left);
  src->Append(right);

  auto dst = new temp::TempList();
  dst->Append(r);

  switch (op_) {
    case PLUS_OP:
      // movq left, r; addq right, r
      instr_list.Append(new assem::MoveInstr("movq `s0, `d0", dst, new temp::TempList({left})));
      instr_list.Append(new assem::OperInstr("addq `s0, `d0", dst, new temp::TempList({right}), nullptr));
      break;

    case MINUS_OP:
      // movq left, r; subq right, r
      instr_list.Append(new assem::MoveInstr("movq `s0, `d0", dst, new temp::TempList({left})));
      instr_list.Append(new assem::OperInstr("subq `s0, `d0", dst, new temp::TempList({right}), nullptr));
      break;

    case MUL_OP: {
      // Multiplication: rax = rax * operand
      // movq left, %rax; imulq right; movq %rax, r
      temp::Temp *rax = reg_manager->GetRegister(frame::X64RegManager::RAX);

      auto rax_list = new temp::TempList();
      rax_list->Append(rax);

      auto mul_src = new temp::TempList();
      mul_src->Append(rax);
      mul_src->Append(right);

      instr_list.Append(new assem::MoveInstr("movq `s0, `d0", rax_list, new temp::TempList({left})));
      instr_list.Append(new assem::OperInstr("imulq `s1", rax_list, mul_src, nullptr));
      instr_list.Append(new assem::MoveInstr("movq `s0, `d0", dst, rax_list));
      break;
    }

    case DIV_OP: {
      // Division: rax = rdx:rax / divisor, rdx = remainder
      // movq left, %rax; cqto; idivq right; movq %rax, r
      temp::Temp *rax = reg_manager->GetRegister(frame::X64RegManager::RAX);
      temp::Temp *rdx = reg_manager->GetRegister(frame::X64RegManager::RDX);

      auto rax_list = new temp::TempList();
      rax_list->Append(rax);

      auto div_dst = new temp::TempList();
      div_dst->Append(rax);
      div_dst->Append(rdx);

      auto div_src = new temp::TempList();
      div_src->Append(rax);
      div_src->Append(rdx);
      div_src->Append(right);

      instr_list.Append(new assem::MoveInstr("movq `s0, `d0", rax_list, new temp::TempList({left})));
      instr_list.Append(new assem::OperInstr("cqto", new temp::TempList({rax, rdx}), rax_list, nullptr));
      instr_list.Append(new assem::OperInstr("idivq `s2", div_dst, div_src, nullptr));
      instr_list.Append(new assem::MoveInstr("movq `s0, `d0", dst, rax_list));
      break;
    }

    default:
      assert(false);
  }

  return r;
  /* End for lab5 code */
}

temp::Temp *MemExp::Munch(assem::InstrList &instr_list, std::string_view fs) {
  /* TODO: Put your lab5 code here */
  temp::Temp *addr = exp_->Munch(instr_list, fs);
  temp::Temp *r = temp::TempFactory::NewTemp();

  auto src = new temp::TempList();
  src->Append(addr);

  auto dst = new temp::TempList();
  dst->Append(r);

  instr_list.Append(new assem::OperInstr(
    "movq (`s0), `d0",
    dst,
    src,
    nullptr
  ));

  return r;
  /* End for lab5 code */
}

