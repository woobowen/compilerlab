temp::Temp *CallExp::Munch(assem::InstrList &instr_list, std::string_view fs) {
  /* TODO: Put your lab5 code here */
  temp::TempList *arg_temps = args_->MunchArgs(instr_list, fs);

  // Get function name
  std::string func_name;
  if (typeid(*fun_) == typeid(tree::NameExp)) {
    auto name_exp = static_cast<tree::NameExp *>(fun_);
    func_name = name_exp->name_->Name();
  } else {
    assert(false);
  }

  // Call instruction
  auto caller_saves = reg_manager->CallerSaves();
  auto return_reg = reg_manager->ReturnValue();

  auto dst = new temp::TempList();
  dst->Append(return_reg);
  // Add caller-saved registers to dst
  for (auto reg : caller_saves->GetList()) {
    dst->Append(reg);
  }

  instr_list.Append(new assem::OperInstr(
    "callq " + func_name,
    dst,
    arg_temps,
    nullptr
  ));

  return return_reg;
  /* End for lab5 code */
}

